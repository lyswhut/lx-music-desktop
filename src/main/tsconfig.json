{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@common/*": ["../common/*"],
      "@main/*": ["./*"],
      "@static/*": ["../static/*"],
      "@/*": ["../*"]
    },
    "typeRoots": [
      "./types",
      "../common/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "./**/*.ts",
    "./types/**/*.d.ts",
    "../common/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}